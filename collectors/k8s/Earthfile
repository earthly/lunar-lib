VERSION 0.8

test:
    # Runs the real main.sh and render.sh inside the collector image, so the tests
    # exercise the helm, yq, jq and parallel it ships. Only `lunar` and
    # `kubeconform` (which fetches schemas over the network) are stubbed.
    FROM +image
    WORKDIR /workspace
    COPY main.sh helm.sh extract.jq render.sh values_sets.py .
    COPY --dir test .
    RUN cd test && python3 -m unittest discover -v

# Build the k8s collector image
image:
    FROM --pass-args ../../+base-image

    # Install kubeconform for K8s manifest validation
    COPY ../../+kubeconform-bin/kubeconform /usr/local/bin/kubeconform

    # Install helm for the helm sub-collector's chart rendering
    # renovate: datasource=github-releases depName=helm/helm extractVersion=^v(?<version>.*)$
    ARG HELM_VERSION=4.3.0
    COPY (+helm-bin/helm --HELM_VERSION=$HELM_VERSION) /usr/local/bin/helm
    RUN helm version --short

    # Install GNU parallel for parallel file processing
    RUN apk add --no-cache parallel && \
        mkdir -p ~/.parallel && touch ~/.parallel/will-cite

    ARG VERSION=main
    SAVE IMAGE --push earthly/lunar-lib:k8s-$VERSION

# Built from source with current x/crypto: the 4.3.0 release binary still ships
# 0.55.0 (fixable Highs).
helm-bin:
    FROM golang:1.27-alpine
    RUN apk add --no-cache git
    ARG --required HELM_VERSION
    RUN git clone --quiet --depth 1 --branch "v${HELM_VERSION}" https://github.com/helm/helm /src
    WORKDIR /src
    RUN go get golang.org/x/crypto@latest && \
        CGO_ENABLED=0 go build -trimpath -ldflags "-w -s \
            -X helm.sh/helm/v4/internal/version.version=v${HELM_VERSION} \
            -X helm.sh/helm/v4/internal/version.metadata= \
            -X helm.sh/helm/v4/internal/version.gitTreeState=clean" \
            -o /out/helm ./cmd/helm
    SAVE ARTIFACT /out/helm
