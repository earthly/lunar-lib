VERSION 0.8

image:
    FROM --pass-args ../../+base-image

    # Install actionlint
    # renovate: datasource=github-releases depName=rhysd/actionlint extractVersion=^v(?<version>.*)$
    ARG ACTIONLINT_VERSION=1.7.12
    COPY (+actionlint-bin/actionlint --ACTIONLINT_VERSION=$ACTIONLINT_VERSION) /usr/local/bin/actionlint

    ARG VERSION=main
    SAVE IMAGE --push earthly/lunar-lib:github-actions-$VERSION

# Built from source so the binary carries a current Go stdlib; upstream's prebuilt
# release binaries lag the Go patch releases that fix stdlib CVEs.
actionlint-bin:
    FROM golang:1.27-alpine
    ARG --required ACTIONLINT_VERSION
    RUN CGO_ENABLED=0 go install "github.com/rhysd/actionlint/cmd/actionlint@v${ACTIONLINT_VERSION}"
    SAVE ARTIFACT /go/bin/actionlint
