VERSION 0.8

test:
    FROM python:3.12-alpine
    # container-rescan.sh is bash and shells out to jq. The tests stub `lunar`
    # and `grype` on PATH and drive the real script as a subprocess.
    RUN apk add --no-cache bash jq
    WORKDIR /workspace
    COPY container-rescan.sh .
    COPY --dir test .
    RUN cd test && python -m unittest discover -v

image:
    FROM --pass-args ../../+base-image

    # Install Grype
    # renovate: datasource=github-releases depName=anchore/grype extractVersion=^v(?<version>.*)$
    ARG GRYPE_VERSION=0.120.1
    COPY (+grype-bin/grype --GRYPE_VERSION=$GRYPE_VERSION) /usr/local/bin/grype

    RUN grype version

    # Pre-bake the vulnerability DB into the image. Grype's DB decompresses to
    # ~1.7GB; materializing it at scan time OOM-kills the memory-limited
    # collector container on the hub (exit 137 — confirmed with both the default
    # cache and a disk-backed cache). Baking it into a read-only image layer
    # lets scans query it on-disk (low memory) with no runtime download. DB
    # freshness is tied to image rebuild cadence; auto.sh disables
    # GRYPE_DB_VALIDATE_AGE so a slightly-older image's DB is not rejected.
    ENV GRYPE_DB_CACHE_DIR=/opt/grype/db
    RUN grype db update && grype db status && chmod -R a+rX /opt/grype

    ARG VERSION=main
    SAVE IMAGE --push earthly/lunar-lib:grype-$VERSION

# Built from source: the 0.120.1 release ships go1.26.8 and x/net 0.59.0, both
# with fixable criticals, and go-jose 4.1.5, a fixable High.
grype-bin:
    FROM golang:1.27-alpine
    RUN apk add --no-cache git
    ARG --required GRYPE_VERSION
    RUN git clone --quiet --depth 1 --branch "v${GRYPE_VERSION}" https://github.com/anchore/grype /src
    WORKDIR /src
    RUN go get golang.org/x/net@latest github.com/go-jose/go-jose/v4@latest && go mod tidy && \
        CGO_ENABLED=0 go build -trimpath -tags containers_image_openpgp,exclude_graphdriver_btrfs \
            -ldflags "-s -w -X main.version=${GRYPE_VERSION} -X main.gitCommit=$(git rev-parse HEAD) -X main.buildDate=$(git log -1 --format=%cI) -X main.gitDescription=v${GRYPE_VERSION}" \
            -o /out/grype ./cmd/grype
    SAVE ARTIFACT /out/grype
