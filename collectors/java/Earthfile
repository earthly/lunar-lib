VERSION 0.8

test:
    FROM python:3.12-alpine
    # test-results.sh is bash and uses find/awk (busybox here, like a minimal CI
    # runner); project.sh also needs jq. The tests stub `lunar` on PATH and
    # drive the real scripts.
    RUN apk add --no-cache bash jq
    WORKDIR /workspace
    COPY test-results.sh cicd.sh project.sh helpers.sh .
    COPY --dir test .
    RUN cd test && python -m unittest discover -v
