VERSION 0.8

# Offline end-to-end test: the real script, curl, jq, python3 and lunar CLI from
# the collector's runtime image, against local stand-ins for the GitHub API and
# a SigV4-verifying S3 and STS (test/servers.py). No network, AWS or Lunar Hub
# needed.
# openssl only generates the stand-in's throwaway TLS cert.
test:
    FROM --pass-args ../../+base-image
    RUN apk add --no-cache openssl
    WORKDIR /workspace
    COPY backup-logs-s3.sh archive-run.sh .
    COPY --dir test .
    RUN ./test/run.sh
