VERSION 0.8

image:
    # Use Debian variant — PHP packages need apt-get
    ARG SCRIPTS_VERSION=1.1.6-debian
    FROM earthly/lunar-scripts:$SCRIPTS_VERSION

    # apt-get upgrade: pull in the OS security fixes Debian has published for the
    # pinned lunar-scripts base (it only installs, never upgrades — see the root
    # Earthfile's base-image for the alpine twin of this). RUN --no-cache so the
    # upgrade re-runs every build instead of coming out of the layer cache.
    RUN --no-cache apt-get update -qq && \
        apt-get upgrade -y && \
        apt-get install -y --no-install-recommends php-cli php-json php-xml && \
        rm -rf /var/lib/apt/lists/*

    # Install Composer
    RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer

    # Verify installations
    RUN php --version && composer --version

    ARG VERSION=main
    SAVE IMAGE --push earthly/lunar-lib:php-$VERSION
