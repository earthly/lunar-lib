VERSION 0.8

test:
    FROM python:3.12-alpine
    # The scripts are bash and shell out to jq and curl, and source helpers.sh.
    # The tests stub `lunar` on PATH, answer Jira from a local HTTP server, and
    # drive the real scripts as subprocesses.
    RUN apk add --no-cache bash jq curl
    WORKDIR /workspace
    COPY ticket.sh ticket_from_json.sh ticket-history.sh helpers.sh .
    COPY --dir test .
    RUN cd test && python -m unittest discover -v
