VERSION 0.8

test:
    FROM python:3.12-alpine
    # container-rescan.sh is bash and shells out to jq. The tests stub `lunar`
    # and `trivy` on PATH and drive the real script as a subprocess.
    RUN apk add --no-cache bash jq
    WORKDIR /workspace
    COPY container-rescan.sh .
    COPY --dir test .
    RUN cd test && python -m unittest discover -v

image:
    FROM --pass-args ../../+base-image

    # Install Trivy
    # renovate: datasource=github-releases depName=aquasecurity/trivy extractVersion=^v(?<version>.*)$
    ARG TRIVY_VERSION=0.76.1
    COPY (+trivy-bin/trivy --TRIVY_VERSION=$TRIVY_VERSION) /usr/local/bin/trivy

    RUN trivy version

    ARG VERSION=main
    SAVE IMAGE --push earthly/lunar-lib:trivy-$VERSION

# Built from source: the 0.76.1 release ships go-jose 4.1.5, a fixable High.
trivy-bin:
    FROM golang:1.27-alpine
    RUN apk add --no-cache git
    ARG --required TRIVY_VERSION
    RUN git clone --quiet --depth 1 --branch "v${TRIVY_VERSION}" https://github.com/aquasecurity/trivy /src
    WORKDIR /src
    RUN go get github.com/go-jose/go-jose/v4@latest && go mod tidy && \
        CGO_ENABLED=0 go build -trimpath \
            -ldflags "-s -w -X github.com/aquasecurity/trivy/pkg/version/app.ver=${TRIVY_VERSION}" \
            -o /out/trivy ./cmd/trivy
    SAVE ARTIFACT /out/trivy
