VERSION 0.8

test:
    FROM python:3.12-alpine
    # sast-fanout.sh is bash and shells out to jq + sha256sum. The tests stub
    # `lunar` on PATH (serving get-json from fixtures, logging every collect)
    # and drive the real script as a subprocess.
    RUN apk add --no-cache bash jq coreutils
    WORKDIR /workspace
    COPY sast-fanout.sh .
    COPY --dir test .
    RUN cd test && python -m unittest discover -v
