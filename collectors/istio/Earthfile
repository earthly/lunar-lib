VERSION 0.8

test:
    # Runs the real main.sh inside the collector image, so the tests exercise the
    # yq, jq and istioctl it ships. Only `lunar` is stubbed.
    FROM +image
    WORKDIR /workspace
    COPY main.sh parse.jq aggregate.jq helm.sh .
    COPY --dir test .
    RUN cd test && python3 -m unittest discover -v

# Build the istio collector image
image:
    FROM --pass-args ../../+base-image

    # Install istioctl for offline Istio config validation (istioctl analyze).
    # renovate: datasource=github-releases depName=istio/istio
    ARG ISTIO_VERSION=1.31.1
    COPY (+istioctl-bin/istioctl --ISTIO_VERSION=$ISTIO_VERSION) /usr/local/bin/istioctl

    ARG VERSION=main
    SAVE IMAGE --push earthly/lunar-lib:istio-$VERSION

# Built from source with current x/crypto and grpc: the 1.31.1 release binary
# still carries fixable Highs in both. Drop the grpc pin once istio moves past it.
istioctl-bin:
    FROM golang:1.27-alpine
    RUN apk add --no-cache git
    ARG --required ISTIO_VERSION
    RUN git clone --quiet --depth 1 --branch "${ISTIO_VERSION}" https://github.com/istio/istio /src
    WORKDIR /src
    # Commit the bumps and tag the commit vX.Y.Z so Go stamps that as the module
    # version. Otherwise the binary claims a v0.0.0-...+dirty pseudo-version, which
    # scanners match against every istio CVE since 2019.
    RUN go get golang.org/x/crypto@latest google.golang.org/grpc@v1.83.2 && \
        git -c user.name=build -c user.email=build@localhost commit -q -am "bump deps" && \
        git tag "v${ISTIO_VERSION}" && \
        CGO_ENABLED=0 go build -trimpath \
            -ldflags "-s -w -X istio.io/istio/pkg/version.buildVersion=${ISTIO_VERSION} -X istio.io/istio/pkg/version.buildStatus=Clean -X istio.io/istio/pkg/version.buildTag=${ISTIO_VERSION}" \
            -o /out/istioctl ./istioctl/cmd/istioctl
    SAVE ARTIFACT /out/istioctl
