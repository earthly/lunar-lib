VERSION 0.8
# Build the argocd collector image: base-image (jq, yq, psql) + kubeconform and
# the argoproj CRD schemas for offline Application/AppProject validation.
image:
    FROM --pass-args ../../+base-image

    # kubeconform for manifest validation
    COPY ../../+kubeconform-bin/kubeconform /usr/local/bin/kubeconform

    # argoproj CRD JSON schemas (datreeio/CRDs-catalog) for offline validation.
    # datreeio filenames are lowercase, which matches what kubeconform's
    # -schema-location template ({{.ResourceKind}} is lowercased) resolves to.
    RUN mkdir -p /opt/argo-schemas/argoproj.io && \
        for r in application_v1alpha1 applicationset_v1alpha1 appproject_v1alpha1; do \
          curl -sSL --fail -o "/opt/argo-schemas/argoproj.io/${r}.json" \
            "https://raw.githubusercontent.com/datreeio/CRDs-catalog/main/argoproj.io/${r}.json"; \
        done

    # GNU parallel for faster file processing
    RUN apk add --no-cache parallel && \
        mkdir -p ~/.parallel && touch ~/.parallel/will-cite

    ARG VERSION=main
    SAVE IMAGE --push earthly/lunar-lib:argocd-$VERSION
