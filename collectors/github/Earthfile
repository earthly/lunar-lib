VERSION 0.8

test:
    FROM python:3.12-alpine
    # The scripts are bash and shell out to jq; the tests stub curl, lunar,
    # and sleep on PATH and drive the real scripts as subprocesses.
    RUN apk add --no-cache bash jq
    WORKDIR /workspace
    COPY branch_protection.sh pull_request.sh release_range.sh .
    COPY --dir test .
    RUN cd test && python -m unittest -v test_branch_protection test_branch_protection_rulesets test_pull_request test_release_range
