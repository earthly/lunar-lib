VERSION 0.8

# Offline end-to-end test of the api sub-collector: the real scripts, curl, jq,
# git and lunar CLI from the collector's runtime image, against a SonarQube Web
# API stand-in (test/sonarqube.py). No network or SonarQube server needed.
test:
    FROM --pass-args ../../+base-image
    WORKDIR /workspace
    COPY api.sh helpers.sh .
    COPY --dir test .
    RUN ./test/run.sh
