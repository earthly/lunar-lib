VERSION 0.8

# lunar-github-token ships in the lunar-lib base image (root +base-image); this
# only tests it, against a stub lunar CLI.
test:
    FROM python:3.12-alpine
    RUN apk add --no-cache bash jq coreutils
    WORKDIR /workspace
    COPY lunar-github-token .
    COPY --dir test .
    # The plugin scripts that call the helper, for test_plugins_use_helper.
    COPY ../+plugin-source/collectors test/collectors
    RUN cd test && python -m unittest -v test_lunar_github_token test_plugins_use_helper
