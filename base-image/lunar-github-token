#!/bin/bash
# Print the GitHub token a plugin should use, preferring one minted from a
# GitHub App held by the Hub (`lunar github-app add`) over a stored secret.
#
#   lunar-github-token [--owner <org>] [--host <host>] [--fallback-env <VAR>]
#
# Mints from the App named by the github_app input (LUNAR_VAR_GITHUB_APP,
# default lunar-lib) for the component's owner and host, or --owner/--host.
# When no token can be minted (no such App, not installed on the owner, a Hub
# or CLI that predates GitHub Apps), prints the token in --fallback-env
# (default LUNAR_SECRET_GH_TOKEN) instead, or nothing if that is unset. With
# the github_app_only input true it exits 1 rather than fall back.
#
# Logs which credential it chose to stderr, never the token itself.
set -uo pipefail

owner=""
host=""
fallback_env="LUNAR_SECRET_GH_TOKEN"
while [ $# -gt 0 ]; do
  case "$1" in
    --owner) owner="${2:-}"; shift 2 ;;
    --host) host="${2:-}"; shift 2 ;;
    --fallback-env) fallback_env="${2:-}"; shift 2 ;;
    *) echo "lunar-github-token: unknown argument: $1" >&2; exit 2 ;;
  esac
done

app="${LUNAR_VAR_GITHUB_APP-lunar-lib}"
app_only="${LUNAR_VAR_GITHUB_APP_ONLY:-false}"
fallback="${!fallback_env:-}"
secret="${fallback_env#LUNAR_SECRET_}"

log() { echo "GitHub auth: $*" >&2; }

use_fallback() {
  if [ "$app_only" = "true" ]; then
    log "no token, because github_app_only is set and $1"
    exit 1
  fi
  if [ -n "$fallback" ]; then
    log "the $secret secret, because $1"
    printf '%s\n' "$fallback"
  else
    log "none, because $1 and the $secret secret is not set"
  fi
  exit 0
}

[ -n "$app" ] || use_fallback "the github_app input is empty"
command -v lunar >/dev/null 2>&1 || use_fallback "the lunar CLI is missing"

args=(github-app get-token "$app" --output-json)
[ -n "$owner" ] && args+=(--owner "$owner")
[ -n "$host" ] && args+=(--host "$host")

err=$(mktemp)
trap 'rm -f "$err"' EXIT
if ! out=$(lunar "${args[@]}" 2>"$err"); then
  # First line of the CLI's error, minus cobra's and gRPC's prefixes.
  reason=$(grep -m1 . "$err" | sed -E 's/^Error: //; s/rpc error: code = [A-Za-z]+ desc = //' | cut -c1-200)
  use_fallback "GitHub App $app can't mint a token: ${reason:-lunar exited non-zero}"
fi

token=$(jq -r '.token // empty' <<<"$out" 2>/dev/null)
[ -n "$token" ] || use_fallback "GitHub App $app returned no token"
log "GitHub App $app (installation $(jq -r '.installation_id // "unknown"' <<<"$out"))"
printf '%s\n' "$token"
