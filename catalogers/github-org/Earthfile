VERSION 0.8

# Offline test: test-local.sh stubs gh and lunar on PATH and drives main.sh as a
# subprocess. On +base-image, not alpine — main.sh builds the repo-name globs
# with sed, and a BusyBox/GNU dialect bug passes on a dev host and dies in the
# shipped image.
test:
    FROM --pass-args ../../+base-image
    WORKDIR /workspace
    COPY main.sh test-local.sh .
    RUN ./test-local.sh

image:
    FROM --pass-args ../../+base-image

    # Install GitHub CLI
    # renovate: datasource=github-releases depName=cli/cli extractVersion=^v(?<version>.*)$
    ARG GH_VERSION=2.102.0
    COPY (+gh-bin/gh --GH_VERSION=$GH_VERSION) /usr/local/bin/gh
    RUN echo "${GH_VERSION}" > /usr/local/bin/gh.version

    ARG VERSION=main
    SAVE IMAGE --push earthly/lunar-lib:github-org-$VERSION

# Built from source: the 2.102.0 release ships go1.27.1 and x/net 0.58.0, both
# with fixable criticals.
gh-bin:
    FROM golang:1.27-alpine
    RUN apk add --no-cache git
    ARG --required GH_VERSION
    RUN git clone --quiet --depth 1 --branch "v${GH_VERSION}" https://github.com/cli/cli /src
    WORKDIR /src
    RUN go get golang.org/x/net@latest && go mod tidy && \
        CGO_ENABLED=0 go build -trimpath \
            -ldflags "-s -w -X github.com/cli/cli/v2/internal/build.Version=${GH_VERSION} -X github.com/cli/cli/v2/internal/build.Date=$(git log -1 --format=%cs)" \
            -o /out/gh ./cmd/gh
    SAVE ARTIFACT /out/gh
