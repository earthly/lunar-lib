VERSION 0.8

# Unit tests for checkout-no-persist-credentials and its exempt_jobs input.
# Wired into the root +test target.
# (No image: target — the github-actions policy runs on the shared base image.)
test:
    FROM python:3.12-alpine
    WORKDIR /workspace
    COPY requirements.txt .
    RUN pip install --no-cache-dir -r requirements.txt
    COPY *.py .
    RUN python -m unittest test_checkout_no_persist_credentials -v
