VERSION 0.8

# Unit tests for the Terraform check suite. Wired into the root +test target —
# it was absent, so none of these ran in CI.
# (No image: target — the terraform policy runs on the shared base image.)
test:
    FROM python:3.12-alpine
    WORKDIR /workspace
    COPY requirements.txt .
    RUN pip install --no-cache-dir -r requirements.txt
    COPY *.py .
    RUN python -m unittest test_aws_soc2_checks -v
