VERSION 0.8

# Unit tests for the istio policy checks. Wired into the root +test target.
# (No image: target — the istio policy runs on the shared base image.)
test:
    FROM python:3.12-alpine
    WORKDIR /workspace
    COPY requirements.txt .
    RUN pip install --no-cache-dir -r requirements.txt
    COPY *.py lunar-policy.yml .
    RUN python -m unittest discover -v
