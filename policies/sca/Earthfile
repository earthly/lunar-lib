VERSION 0.8

# Unit tests for the SCA policy checks: the max-severity verdict (severity
# filtering, multi-scanner finding dedup, `ignore_unfixable` narrowing) and the
# webhook alert helper — including that the published payload schema stays
# exactly schema_version 1's key set.
# Wired into the root +test target.
# (No image: target — the sca policy runs on the shared base image.)
test:
    FROM python:3.12-alpine
    WORKDIR /workspace
    COPY requirements.txt .
    RUN pip install --no-cache-dir -r requirements.txt
    COPY *.py .
    RUN python -m unittest test_max_severity test_webhook_alert -v
