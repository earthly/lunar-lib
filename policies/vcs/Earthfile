VERSION 0.8

# Unit tests for the VCS policy checks. Wired into the root +test target.
# (No image: target — the vcs policy runs on the shared base image.)
test:
    FROM python:3.12-alpine
    WORKDIR /workspace
    COPY requirements.txt .
    RUN pip install --no-cache-dir -r requirements.txt
    # test_vcs_policies reads the manifest to model a broad import's input defaults.
    COPY *.py lunar-policy.yml .
    RUN python -m unittest test_vcs_policies -v
