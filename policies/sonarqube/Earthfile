VERSION 0.8

# Unit tests for the sonarqube policy's quality-gate-passing check, on the gates
# the collector's api and github-app sub-collectors write. Wired into the root
# +test target. (No image: target — the policy runs on the shared base image.)
test:
    FROM python:3.12-alpine
    WORKDIR /workspace
    COPY requirements.txt .
    RUN pip install --no-cache-dir -r requirements.txt
    COPY *.py .
    RUN python -m unittest test_quality_gate_passing -v
