# The release image bakes no DB, and its scripts run trivy without
# --cache-dir, so trivy reads $HOME/.cache/trivy. Baking both DBs there lets
# the release's own scripts skip the per-scan download while a DB is fresh;
# past its NextUpdate, trivy downloads one as before. The cache gets $HOME's
# 1000:0 ownership so a non-root uid can still write trivy's scan cache.
ARG BASE
FROM ${BASE}
RUN trivy image --download-db-only --no-progress && \
    trivy image --download-java-db-only --no-progress && \
    chown -R 1000:0 "$HOME/.cache" && \
    chmod -R g=u,a+rX "$HOME/.cache"
